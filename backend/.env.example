# Azure OpenAI — GPT-5.4 with vision (uses DefaultAzureCredential via `az login`)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Alt model (fallback)
AZURE_OPENAI_ENDPOINT_ALT=https://your-alt-openai-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_ALT=gpt-5-chat

# Azure Content Understanding (OCR + layout extraction)
AZURE_CU_ENDPOINT=https://your-cu-resource.cognitiveservices.azure.com
AZURE_CU_ANALYZER=floorplan-analyzer-v4

# data.gov.sg API key (for HDB resale valuation)
DATAGOVSG_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
