# Export as process environment; automatic .env loading is intentionally disabled.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-VISION-DEPLOYMENT
AZURE_OPENAI_AUTH_MODE=entra
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Alternatively use key auth and supply the key through your secret manager.
# AZURE_OPENAI_AUTH_MODE=key
# AZURE_OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3310,http://127.0.0.1:3310,http://127.0.0.1:3312
